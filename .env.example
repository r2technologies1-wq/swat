# Server-only environment variables.
# Copy this file to .env locally, then paste real values after the equals signs.
# Never commit the real .env file.

# Required: OpenAI API key for /api/trainer.
OPENAI_API_KEY=

# Required: Neon pooled or direct Postgres connection string.
NEON_DATABASE_URL=

# Optional: accepted only as a fallback if your host already uses DATABASE_URL.
DATABASE_URL=

# Optional model choices.
OPENAI_MODEL=gpt-5-mini
OPENAI_SUMMARY_MODEL=gpt-5-mini

# Optional trainer identity.
TRAINER_ATHLETE_KEY=local-demo
TRAINER_ATHLETE_NAME=Ryan
TRAINER_TIMEZONE=America/New_York

# Optional local port. 5174 avoids the stale frontend-only 5173 process on this Mac.
PORT=5174
